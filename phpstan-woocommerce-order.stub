<?php

namespace {

/**
 * Minimal WooCommerce order API surface used by the project plugin.
 * WooCommerce itself is excluded from PHPStan analysis.
 */
class WC_Order
{
	public function get_meta(string $key = '', bool $single = false, string $context = 'view'): mixed {}

	public function update_meta_data(string $key, mixed $value, mixed $meta_id = ''): void {}

	public function delete_meta_data(string $key): void {}

	public function save(): int {}

	public function get_type(): string {}

	public function get_id(): int {}
}

class WC_Order_Refund extends WC_Order {}

function wc_get_order(int $order_id): WC_Order|false {}
}

namespace Automattic\WooCommerce\Utilities {
class OrderUtil
{
	public static function custom_orders_table_usage_is_enabled(): bool {}
}
}
